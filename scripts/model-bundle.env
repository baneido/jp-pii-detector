# モデル同梱ビルド（scripts/package-model-bundle.sh）が取得する外部成果物のピン留め。
# bash から source する。値を変えたら docs/model-bundle.md の表も更新すること。
#
# Sumi（Apache-2.0）。リビジョンは Hugging Face のコミット SHA で固定し、
# 各ファイルの SHA-256 を検証する。いずれも未改変のまま同梱する。
SUMI_REPO=NagaYu/sumi-ja-pii
SUMI_REVISION=daa43a033830a38911b178e7951b97ad64b0080a
SUMI_SHA256_model_int8_onnx=0c301e9925c0b35331043e6dab4af79efe91fab1e79c0b016899906717117de7
SUMI_SHA256_tokenizer_json=6a0734cf21c802169defaffe719bc2ef12bb9d0be37e54b61ed27aa89394723d
SUMI_SHA256_sumi_labels_json=3f2ef2f12b4d2739168f2fd6ce719386e0f3769826297179bb811c7d5fc4f450
SUMI_SHA256_calibrator_json=46732913eceb80facb0ba36f133f35de15ade39afd4431484246def2ec7f5369

# ONNX Runtime（MIT）。公式リリースの CPU 版アーカイブと、その SHA-256（GitHub の
# アセット digest）。github.com/microsoft/onnxruntime/go は ORT_API_VERSION 29 以上を要る。
ORT_VERSION=1.31.0
ORT_SHA256_linux_x64=cc5c72baf5ae5c8238a6841f0897227be2d02826b9cf98eaf02fdefaeeb03a57
ORT_SHA256_linux_aarch64=c5b8b3cca31f3d643a3b313b8f42e2d0f16a4fcefd02cda343d97bd5306afaab
ORT_SHA256_osx_arm64=1031b36dd3bdaa8d976a6130d9cf2a05e9be320b93ae804f8427b91dc3432afc
ORT_SHA256_win_x64=3958d8a44984160692c1b4ffd0de3cb48f8c39f9d34bb31e433db06e30b82195
